## Load packages
library(rgbif) #access GBIF API
library(rnaturalearth)
library(rnaturalearthdata) #access world data
library(sf) #handles spatial data
install.packages("rgbif")
## GET GBIF data using occ_search()----
?occ_search
## Load packages
library(rgbif) #access GBIF API
## GET GBIF data using occ_search()----
?occ_search
occ_search(scientificName = "Calopteryx splendens")
occ_data <- occ_search(scientificName = "Calopteryx splendens",country = "DK",year="1999,2005")
names(occ_data) # the file is a list of different data sets
View(occ_data)
occ_data$hierarchy
occ_data$meta
occ_data$media
names(occ_data) # the file is a list of different elements
occ_data$facets
occ_data$data #data is what we need
occ_data$hierarchy
# subset data set
occ_data1 <- occ_data[["data"]] # to get the actual required data
# Explore data
head(occ_data1)
names(occ_data1)
unique(occ_data1$issues)
unique(occ_data1$datasetKey)
unique(occ_data1$basisOfRecord)
# get country borders
world_map <- ne_countries(scale = "medium", type = "countries", returnclass="sf")
# make a simple plot
plot(st_geometry(world_map),axes=T)
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=1,col="red")
# zoom to Europe
plot(st_geometry(world_map),axes=T,xlim=c(-5,30), ylim=c(40,60))
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=1,col="red")
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=2,col="red")
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red")
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red", cex=1.5)
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red", cex=1)
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red", cex=0.5)
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red", cex=0.5)
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red", cex=0.5)
# zoom to Europe
plot(st_geometry(world_map),axes=T,xlim=c(-5,30), ylim=c(40,60))
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red", cex=0.5)
# zoom to Europe
plot(st_geometry(world_map),axes=T,xlim=c(0,25), ylim=c(50,60))
points(occ_data1$decimalLongitude, occ_data1$decimalLatitude ,pch=19,col="red", cex=0.5)
name_backbone("Calopteryx") # get best match in the GBIF backbone
name_suggest("Calopteryx splendens") # can be useful if you aren't sure which name to use
name_backbone("Calopteryx splendens") # get best match in the GBIF backbone
name_backbone("Puma concolor")
name_suggest("Puma concolor") # can be useful if you aren't sure which name to use
name_backbone("Felis concolor")
name_backbone("Felis concolor")[,1:8]
occ_count() # total number of occurrences in GBIF
occ_count(hasCoordinate=TRUE) # occurrences with coordinates
occ_count(basisOfRecord='OBSERVATION') # occurrences with "this"OBESERVATION" as basis of record
occ_count(taxonKey=2435099, hasCoordinate=TRUE) # Puma concolor occurrences with coordinates
occ_count(country="DK") # occurrences from Denmark
occ_count(datasetKey='9e7ea106-0bf8-4087-bb61-dfe4f29e0f17') # occurrences from a particular dataset
occ_count(year=2012) # occurrence from a particular year
## get occurrence data for individual species, countries, time periods...
occ_data1 <- occ_search(scientificName = "Calopteryx splendens")
occ_data1bis <- occ_search(scientificName = "Calopteryx splendens",limit=10000) # what's the difference?
## get occurrence data for individual species, countries, time periods...
occ_data1 <- occ_search(scientificName = "Calopteryx splendens")
occ_data1bis <- occ_search(scientificName = "Calopteryx splendens",limit=10000) # what's the difference?
## get occurrence data for individual species, countries, time periods...
occ_data1 <- occ_search(scientificName = "Calopteryx splendens")$data
occ_data1bis <- occ_search(scientificName = "Calopteryx splendens",limit=10000)$data # what's the difference?
## Get GBIF data using occ_download()----
?occ_download
